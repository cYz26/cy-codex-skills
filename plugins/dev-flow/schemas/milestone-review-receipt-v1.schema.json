{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://devflow.local/schemas/milestone-review-receipt-v1.schema.json","title":"DevFlow independent milestone review receipt","type":"object","additionalProperties":false,"required":["schemaVersion","contractId","candidateDigest","reviewedDiffDigest","reviewer","reviewMode","evidence","p0","p1","status"],"properties":{"schemaVersion":{"const":"1.0"},"contractId":{"type":"string","minLength":1},"candidateDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"reviewedDiffDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"reviewer":{"type":"string","minLength":1},"reviewMode":{"const":"independent-read-only"},"evidence":{"$ref":"#/$defs/evidence"},"p0":{"const":0},"p1":{"const":0},"status":{"const":"pass"}},"$defs":{"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"evidence":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha"}}}}}
