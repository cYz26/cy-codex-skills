{
  "schemaVersion": 2,
  "capabilityRegistry": "provider_profiles.json#/capabilities",
  "routes": [
    {
      "id": "mandatory-full-openspec",
      "label": "Full OpenSpec",
      "kinds": [
        "new-feature",
        "behavior-change",
        "api-change",
        "data-model-change",
        "migration",
        "integration",
        "permission-change",
        "error-handling-change",
        "compatibility-change"
      ],
      "requiredArtifacts": ["proposal.md", "design.md", "specs", "tasks.md"],
      "requiredCapabilities": [
        "decision-resolution",
        "implementation-planning",
        "test-first-execution",
        "change-review",
        "completion-proof"
      ],
      "conditionalCapabilities": [
        {
          "capability": "root-cause-diagnosis",
          "when": "hard bug, regression, or unexpected behavior"
        },
        {
          "capability": "execution-orchestration",
          "when": "approved work is delegated, parallelized, or isolated"
        }
      ],
      "recommendedSkillWhenReady": "openspec-apply-change",
      "recommendedSkillWhenRevising": "openspec-update-change",
      "recommendedSkillWhenBlocked": "openspec-propose"
    },
    {
      "id": "lightweight-ledger-low-risk",
      "label": "Lightweight Ledger",
      "kinds": ["docs-only", "test-only", "internal-maintenance", "low-risk-bugfix", "tooling"],
      "requiredArtifacts": ["TASK_LEDGER.md", "EVIDENCE_TEMPLATE.md", "REVIEW_CHECKLIST.md"],
      "requiredCapabilities": [
        "test-first-execution",
        "change-review",
        "completion-proof"
      ],
      "conditionalCapabilities": [
        {
          "capability": "root-cause-diagnosis",
          "when": "the item is a hard bug, regression, or unexpected behavior"
        },
        {
          "capability": "execution-orchestration",
          "when": "approved work is delegated, parallelized, or isolated"
        }
      ],
      "recommendedSkillWhenReady": "execute-task"
    },
    {
      "id": "prototype-explicit-only",
      "label": "Prototype Mode",
      "kinds": ["prototype", "spike", "proof-of-concept"],
      "requiredArtifacts": ["TASK_LEDGER.md"],
      "requiredCapabilities": [
        "decision-resolution",
        "architecture-guidance",
        "completion-proof"
      ],
      "conditionalCapabilities": [],
      "recommendedSkillWhenReady": "feature-intake"
    }
  ]
}
