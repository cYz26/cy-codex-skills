{
  "schemaVersion": 1,
  "targetSuperpowersVersion": "6.1.1",
  "fallbackCompatibleVersion": "5.1.3",
  "gates": [
    {
      "id": "method-bootstrap",
      "skill": "using-superpowers",
      "requiredInStrictProfile": true,
      "when": ["session-start", "before-first-devflow-routing"],
      "devflowAction": "diagnose-selected-manifest-hooks"
    },
    {
      "id": "design-before-implementation",
      "skill": "brainstorming",
      "requiredInStrictProfile": true,
      "when": ["creative-work", "new-feature", "behavior-modification", "open-questions-remain"],
      "blocks": ["change-plan-approval", "execute-task"]
    },
    {
      "id": "plan-before-code",
      "skill": "writing-plans",
      "requiredInStrictProfile": true,
      "when": ["approved-design", "multi-step-task", "migration", "delegation-or-subagent-work"],
      "blocks": ["execute-task"]
    },
    {
      "id": "implementation-correctness",
      "skill": "test-driven-development",
      "requiredInStrictProfile": true,
      "when": ["new-feature", "bug-fix", "refactor", "behavior-change"],
      "evidenceRequired": ["red_test_output", "green_test_output"]
    },
    {
      "id": "verification-before-completion",
      "skill": "verification-before-completion",
      "requiredInStrictProfile": true,
      "when": ["completion-claim", "archive-request", "release-promotion", "before-commit-or-pr"],
      "blocks": ["completion-claim", "archive", "release-promotion"]
    }
  ]
}
