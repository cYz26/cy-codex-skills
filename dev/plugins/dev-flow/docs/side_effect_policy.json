{
  "schemaVersion": 1,
  "defaultDeny": true,
  "effects": {
    "workspace.read": {
      "authorization": "task_scope",
      "denial": "omit_and_report"
    },
    "draft.write": {
      "authorization": "declared_draft_write_set",
      "denial": "chat_or_stop"
    },
    "canonical.write": {
      "authorization": "approved_promoter_write_set",
      "denial": "require_promotion"
    },
    "code_test.modify": {
      "authorization": "approved_task_write_set",
      "denial": "block"
    },
    "git.branch_worktree": {
      "authorization": "approved_isolation_plan",
      "denial": "inline_or_stop"
    },
    "git.commit": {
      "authorization": "explicit_user_request",
      "denial": "leave_uncommitted"
    },
    "git.push": {
      "authorization": "explicit_user_request",
      "denial": "do_not_contact_remote"
    },
    "git.push_pr": {
      "authorization": "explicit_user_request",
      "denial": "do_not_contact_remote",
      "compatibilityAlias": true,
      "replacementEffects": [
        "git.push",
        "github.control_plane_write"
      ]
    },
    "github.control_plane_write": {
      "authorization": "explicit_user_request_and_credentials",
      "denial": "await_credentials"
    },
    "tracker.read": {
      "authorization": "task_scope_and_credentials",
      "denial": "do_not_query"
    },
    "tracker.write": {
      "authorization": "explicit_user_request",
      "denial": "return_draft"
    },
    "dependency.install_update": {
      "authorization": "explicit_named_dependency_request",
      "denial": "dry_run_only"
    },
    "model.invoke": {
      "authorization": "current_standing_goal_execution_authority",
      "denial": "do_not_invoke"
    },
    "destructive.cleanup": {
      "authorization": "explicit_file_list_and_rollback",
      "denial": "preserve_and_report"
    },
    "release.promote_local": {
      "authorization": "verified_approved_write_set",
      "denial": "ready_not_applied"
    },
    "release.publish": {
      "authorization": "current_standing_milestone_contract",
      "denial": "do_not_publish"
    },
    "devflow.source.fast_forward_named": {
      "authorization": "current_standing_milestone_contract",
      "denial": "do_not_update_source"
    },
    "plugin.cache.refresh_named": {
      "authorization": "current_standing_milestone_contract",
      "denial": "do_not_refresh"
    },
    "devflow.project.refresh_named": {
      "authorization": "current_standing_milestone_contract",
      "denial": "do_not_refresh"
    },
    "openspec.archive": {
      "authorization": "explicit_archive_intent",
      "denial": "do_not_archive"
    },
    "archive_release": {
      "authorization": "verified_and_explicit_user_request",
      "denial": "ready_not_applied",
      "compatibilityAlias": true,
      "replacementEffects": [
        "release.promote_local",
        "release.publish",
        "openspec.archive"
      ]
    },
    "goal.state": {
      "authorization": "explicit_user_request_and_quality_gate",
      "denial": "goal_mode_prompt_only"
    }
  }
}
