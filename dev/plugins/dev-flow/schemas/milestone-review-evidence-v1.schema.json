{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://devflow.local/schemas/milestone-review-evidence-v1.schema.json","title":"DevFlow independent milestone review evidence","type":"object","additionalProperties":false,"required":["schemaVersion","kind","contractId","reviewer","reviewMode","p0","p1","status"],"properties":{"schemaVersion":{"const":"1.0"},"kind":{"const":"devflow-milestone-review-evidence"},"contractId":{"type":"string","minLength":1},"reviewer":{"type":"string","minLength":1},"reviewMode":{"const":"independent-read-only"},"p0":{"type":"integer","minimum":0},"p1":{"type":"integer","minimum":0},"status":{"enum":["pass","fail"]}},"allOf":[{"if":{"properties":{"status":{"const":"pass"}},"required":["status"]},"then":{"properties":{"p0":{"const":0},"p1":{"const":0}}}},{"if":{"properties":{"status":{"const":"fail"}},"required":["status"]},"then":{"anyOf":[{"properties":{"p0":{"minimum":1}}},{"properties":{"p1":{"minimum":1}}}]}}]}
