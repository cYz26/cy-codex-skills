{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generated-artifact-manifest/v1",
  "title": "Generated Artifact Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contractSha256",
    "contractSeal",
    "observedAtNs",
    "repository",
    "taskId",
    "runId",
    "owner",
    "commandResult",
    "entries",
    "scopeInventories"
  ],
  "properties": {
    "schema": {
      "const": "generated-artifact-manifest/v1"
    },
    "contractSha256": {
      "$ref": "#/$defs/sha256"
    },
    "contractSeal": {
      "$ref": "#/$defs/identity"
    },
    "observedAtNs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "taskId": {
      "$ref": "#/$defs/identifier"
    },
    "runId": {
      "$ref": "#/$defs/identifier"
    },
    "owner": {
      "$ref": "#/$defs/manifestOwner"
    },
    "commandResult": {
      "$ref": "#/$defs/commandResult"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manifestEntry"
      }
    },
    "scopeInventories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scopeInventory"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "device",
        "inode",
        "gitRoot"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "inode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "gitRoot": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "manifestOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pid",
        "uid",
        "processAlive",
        "leaseActive",
        "completed"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "uid": {
          "type": "integer",
          "minimum": 0
        },
        "processAlive": {
          "type": "boolean"
        },
        "leaseActive": {
          "type": "boolean"
        },
        "completed": {
          "type": "boolean"
        }
      }
    },
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exitCode",
        "completed"
      ],
      "properties": {
        "exitCode": {
          "type": "integer"
        },
        "completed": {
          "const": true
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type",
        "device",
        "inode",
        "mode",
        "nlink",
        "uid",
        "gid",
        "mtimeNs",
        "ctimeNs",
        "size",
        "sha256",
        "members"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "file",
            "directory",
            "symlink",
            "socket",
            "fifo",
            "device",
            "other"
          ]
        },
        "device": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "inode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "nlink": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "gid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "mtimeNs": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "ctimeNs": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "type": {
                  "const": "file"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "members": {
                  "maxItems": 0
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "directory"
                },
                "sha256": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "enum": [
                    "symlink",
                    "socket",
                    "fifo",
                    "device",
                    "other"
                  ]
                },
                "sha256": {
                  "type": "null"
                },
                "members": {
                  "maxItems": 0
                }
              }
            }
          ]
        }
      ]
    },
    "manifestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeId",
        "path",
        "type",
        "device",
        "inode",
        "mode",
        "nlink",
        "uid",
        "gid",
        "mtimeNs",
        "ctimeNs",
        "size",
        "sha256",
        "members"
      ],
      "properties": {
        "scopeId": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "file",
            "directory",
            "symlink",
            "socket",
            "fifo",
            "device",
            "other"
          ]
        },
        "device": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "inode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "nlink": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "gid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "mtimeNs": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "ctimeNs": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "type": {
                  "const": "file"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "members": {
                  "maxItems": 0
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "directory"
                },
                "sha256": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "enum": [
                    "symlink",
                    "socket",
                    "fifo",
                    "device",
                    "other"
                  ]
                },
                "sha256": {
                  "type": "null"
                },
                "members": {
                  "maxItems": 0
                }
              }
            }
          ]
        }
      ]
    },
    "scopeInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeId",
        "entries"
      ],
      "properties": {
        "scopeId": {
          "$ref": "#/$defs/identifier"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        }
      }
    }
  }
}
