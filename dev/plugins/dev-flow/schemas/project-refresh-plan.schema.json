{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devflow.local/schemas/project-refresh-plan.schema.json",
  "title": "DevFlow project refresh plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "ok",
    "status",
    "repo",
    "actions",
    "readSet",
    "writeSet",
    "requiredAuthorizations",
    "manualActions",
    "preservedPaths",
    "verification",
    "retryability",
    "planSha256",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "kind": {"const": "devflow-project-refresh-plan"},
    "ok": {"type": "boolean"},
    "status": {
      "enum": [
        "not_applicable",
        "current",
        "migration_pending",
        "manual_review_required",
        "baseline_ambiguous",
        "blocked"
      ]
    },
    "repo": {"type": "string", "minLength": 1},
    "actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/action"}
    },
    "readSet": {"$ref": "#/$defs/pathArray"},
    "sourceReadSet": {"$ref": "#/$defs/pathArray"},
    "writeSet": {"$ref": "#/$defs/pathArray"},
    "requiredAuthorizations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "manualActions": {"type": "array", "items": {"type": "object"}},
    "preservedPaths": {"$ref": "#/$defs/pathArray"},
    "verification": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "retryability": {"type": "string", "minLength": 1},
    "projectContentStatus": {"type": "string"},
    "migrationState": {"type": "object"},
    "stateSyncRequired": {"type": "boolean"},
    "recovery": {"type": "object"},
    "planSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nextAction": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "pathArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256"],
      "properties": {
        "kind": {"enum": ["absent", "file", "symlink", "tree", "non_regular", "unreadable"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "action": {
      "type": "object",
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": {"kind": {"const": "quarantine_path"}}
          },
          "then": {
            "required": ["quarantinePath", "selectionGroup"],
            "properties": {
              "rollback": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "quarantinePath", "pruneEmptyParents"],
                "properties": {
                  "kind": {"const": "restore_quarantine"},
                  "quarantinePath": {"type": "string", "minLength": 1},
                  "pruneEmptyParents": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": {"kind": {"const": "replace_json"}}
          },
          "then": {
            "properties": {
              "rollback": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "commit", "blob", "mode"],
                    "properties": {
                      "kind": {"const": "git_blob"},
                      "commit": {"type": "string", "minLength": 1},
                      "blob": {"type": "string", "minLength": 1},
                      "mode": {"type": "integer", "minimum": 0, "maximum": 511}
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "targetVersion", "path", "mode"],
                    "properties": {
                      "kind": {"const": "config_target"},
                      "targetVersion": {"type": "integer", "minimum": 0},
                      "path": {"type": "string", "minLength": 1},
                      "mode": {"type": "integer", "minimum": 0, "maximum": 511}
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "required": [
        "id",
        "kind",
        "path",
        "beforeFingerprint",
        "afterFingerprint",
        "authorization",
        "dependencies",
        "ownership",
        "source",
        "rollback",
        "verification"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["create_file", "replace_json", "create_symlink", "replace_symlink", "quarantine_path"]},
        "path": {"type": "string", "minLength": 1},
        "quarantinePath": {"type": "string", "minLength": 1},
        "selectionGroup": {"type": "string", "minLength": 1},
        "beforeFingerprint": {"$ref": "#/$defs/fingerprint"},
        "afterFingerprint": {"$ref": "#/$defs/fingerprint"},
        "authorization": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "ownership": {"type": "string", "minLength": 1},
        "source": {"type": "object"},
        "rollback": {"type": "object"},
        "verification": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
