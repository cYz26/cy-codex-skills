{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devflow.local/schemas/authority-delta-resolution-v1.schema.json",
  "title": "DevFlow authority-delta resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decision",
    "reasonCodes",
    "missingAuthority",
    "invalidations",
    "materialDelta",
    "requestDigest",
    "authorityDigest",
    "evidenceDigest",
    "standingContractDigest",
    "gateKey"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "decision": {
      "enum": [
        "CONTINUE",
        "CONTINUE_WITH_MINIMAL_GUARD",
        "DEFER_AND_CONTINUE",
        "WAIT_OWNER",
        "AUTO_CLEAN",
        "FAIL_CLOSED_REPAIR",
        "AWAIT_HUMAN"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "missingAuthority": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "invalidations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "materialDelta": {"type": "boolean"},
    "requestDigest": {"$ref": "#/$defs/sha256"},
    "authorityDigest": {"$ref": "#/$defs/sha256"},
    "evidenceDigest": {"$ref": "#/$defs/sha256"},
    "standingContractDigest": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "gateKey": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "AWAIT_HUMAN"}}},
      "then": {
        "properties": {
          "missingAuthority": {"minItems": 1},
          "materialDelta": {"const": true},
          "gateKey": {"$ref": "#/$defs/sha256"}
        }
      },
      "else": {
        "properties": {
          "missingAuthority": {"maxItems": 0},
          "gateKey": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
