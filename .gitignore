.DS_Store
plugins/godot-core/evals/artifacts/
.release/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/

# Project-local Codex/GSD runtime is generated by installers. Keep only
# the small files needed to understand and refresh the local setup.
.codex/**
!.codex/
!.codex/README.md
!.codex/.gsd-profile

# Official project-local repo skills are generated by DevFlow activation.
# Keep marketplace catalogs tracked, but do not commit generated skill links.
.agents/skills/

# Local orchestration state is useful in-session but should not be committed
# unless intentionally sharing the current development checkpoint.
.planning/
# Provider benchmark checkpoints and locks are reproducible test fixtures, not
# live project state. Keep this narrow fixture subtree versioned.
!dev/plugins/dev-flow/fixtures/provider-profiles/*/.planning/
!dev/plugins/dev-flow/fixtures/provider-profiles/*/.planning/devflow/
!dev/plugins/dev-flow/fixtures/provider-profiles/*/.planning/devflow/STATE.md
!dev/plugins/dev-flow/fixtures/provider-profiles/*/.planning/devflow/providers.lock.json
.dev-flow/
openspec/changes/
setup-report.md
repair-plan.md
workflow-diagnosis.md
log/

dev/log/
dev/plugins/*/log/
dev/skills/*/log/
dev/tools/*/.codex/
dev/tools/*/log/
